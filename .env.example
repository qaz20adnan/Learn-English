# English Journey Academy - environment variables
# Copy this file to `.env.local` and adjust. NEVER commit real secrets.

# Absolute or relative path to the SQLite database file.
# Defaults to ./data/academy.db when unset.
DATABASE_PATH=./data/academy.db

# Interval (in seconds) used for the progress heartbeat sent from the player.
NEXT_PUBLIC_PROGRESS_HEARTBEAT_SECONDS=10

# Comma separated list of origins allowed to embed media (informational only).
# Media embeddability is verified server-side against the provider oEmbed API.

# Base URL used in absolute links (optional, informational).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
