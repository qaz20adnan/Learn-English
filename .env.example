# English Journey Academy - environment variables
# Copy this file to `.env.local` and adjust. NEVER commit real secrets.

# PostgreSQL connection string (required).
# Neon: use the *pooled* connection string (the host contains `-pooler`).
# Example: postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Set to `disable` for a local PostgreSQL server without TLS. Defaults to SSL on
# any non-localhost host (required by Neon/Supabase).
# DATABASE_SSL=disable

# Maximum connections kept in the server-side pool (default: 3).
# DATABASE_POOL_MAX=3

# Optional YouTube Data API v3 key. When set, `npm run db:sync -- --refresh`
# uses the official API for playlist videos (titles, descriptions, durations and
# published dates). Without a key the sync falls back to the public InnerTube
# endpoint and the structured catalog in `src/lib/content/catalog.ts`.
# YOUTUBE_API_KEY=
# Channel handle used by the optional channel-discovery helper.
# YOUTUBE_CHANNEL_HANDLE=@zamericanenglish

# Interval (in seconds) used for the progress heartbeat sent from the player.
NEXT_PUBLIC_PROGRESS_HEARTBEAT_SECONDS=10

# Base URL used in absolute links (optional, informational).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: created/promoted by `npm run db:seed`.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Academy Admin
