{
  "name": "english-journey-academy",
  "version": "0.1.0",
  "private": true,
  "description": "English Journey Academy - a full-stack English learning platform (courses, media, vocabulary, stories, progress, admin).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/fix-standalone-symlinks.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "tsx --env-file-if-exists=.env.local scripts/setup-db.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:sync": "tsx --env-file-if-exists=.env.local scripts/sync-catalog.ts",
    "db:stories": "tsx --env-file-if-exists=.env.local scripts/sync-stories.ts",
    "db:verify-media": "tsx --env-file-if-exists=.env.local scripts/verify-media.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^27.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
